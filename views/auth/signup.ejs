<% layout("layouts/main") %>
<section class="auth">
    <div class="auth-art auth-art--signup" aria-hidden="true">
        <div class="auth-art-inner">
            <div class="auth-brand-badge">
                <svg class="brand-mark brand-mark-lg" viewBox="0 0 36 36"><use href="#i-logo"/></svg>
                <span class="auth-brand-text">Wanderlust</span>
            </div>
            <h2>Your next adventure starts here.</h2>
            <p>Save favourites, book stays, leave reviews and host your own space.</p>
        </div>
    </div>
    <div class="auth-panel">
        <form class="auth-card" action="/signup?_csrf=<%= csrfToken %>" method="post" novalidate data-validate>
            <h1>Create your account</h1>
            <p class="muted">Already have one? <a href="/login">Log in</a></p>
            <% if (firebaseConfig) { %>
                <button type="button" class="btn btn-ghost btn-block btn-firebase" id="firebase-google-btn">
                    <svg class="google-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Sign up with Google</span>
                </button>
                <div class="auth-divider"><span>or with email &amp; password</span></div>
            <% } %>
            <div class="field">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" autocomplete="username" minlength="3" maxlength="30" pattern="[A-Za-z0-9_.\-]+" required autofocus>
                <p class="field-error">3–30 characters: letters, numbers, dots, dashes or underscores.</p>
            </div>
            <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" autocomplete="email" required>
                <p class="field-error">Enter a valid email address.</p>
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" autocomplete="new-password" minlength="8" required>
                <p class="field-error">At least 8 characters.</p>
            </div>
            <button class="btn btn-primary btn-block" type="submit" data-loading-text="Creating account…">Sign up</button>
        </form>
    </div>
</section>
<% if (firebaseConfig) { %>
    <script type="application/json" id="firebase-config"><%- JSON.stringify(firebaseConfig) %></script>
    <script type="module" src="/js/firebase-auth.js"></script>
<% } %>
