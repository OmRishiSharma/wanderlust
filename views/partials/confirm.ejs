<dialog class="dialog" id="confirm-dialog" aria-labelledby="confirm-title">
    <form method="dialog">
        <h2 id="confirm-title">Are you sure?</h2>
        <p id="confirm-text">This action cannot be undone.</p>
        <div class="dialog-actions">
            <button value="cancel" class="btn btn-ghost">Cancel</button>
            <button value="ok" class="btn btn-danger" id="confirm-ok">Confirm</button>
        </div>
    </form>
</dialog>
