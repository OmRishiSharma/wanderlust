# Copy this file to .env and fill in the values.
NODE_ENV=development
PORT=8080

# Public URL of the site (used for sitemap/canonical links). Optional locally.
BASE_URL=

# Local MongoDB, or a MongoDB Atlas connection string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wanderlust?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017/wanderlust

# Long random string. Generate one with:
#   node -p "require('crypto').randomBytes(48).toString('hex')"
SESSION_SECRET=change-me

# Optional: Cloudinary for image uploads. If left empty, uploads are saved to public/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: password for an "admin" user created by `npm run seed`
SEED_ADMIN_PASSWORD=

# Firebase Client Configuration (for authentication)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
